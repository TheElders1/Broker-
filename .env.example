# Genesis Pro LTD — environment variable placeholders
# Copy this file to .env.local and fill in real values before connecting
# any backend service. Nothing in this repository reads real secrets —
# these names exist so the frontend has a documented integration surface.
#
# SECURITY: Only NEXT_PUBLIC_* variables are ever sent to the browser.
# Never put an API secret, database credential, VPS credential, or any
# Bitcoin wallet private key in a NEXT_PUBLIC_* variable — those must stay
# server-side only, on the backend running on the VPS, never in this
# frontend project.

# --- Core API connection (required to leave demo mode) ---
# Base URL of the backend API hosted on the VPS, e.g. https://api.genesispro.com
# Do NOT hardcode a VPS IP address anywhere in the frontend — always go
# through this single configurable value. See lib/api/config.ts.
NEXT_PUBLIC_API_BASE_URL=

# "demo"        — no backend connected; UI shows clearly-labelled mock data.
# "production"  — calls the real backend at NEXT_PUBLIC_API_BASE_URL and
#                 never fabricates balances, wallets, or transactions.
NEXT_PUBLIC_APP_MODE=demo

# Public URL this site is deployed at (used for metadata, canonical links,
# robots.txt, and sitemap.xml). On Render this is your service's
# https://<service-name>.onrender.com URL, or your custom domain once
# attached. See lib/siteUrl.ts.
NEXT_PUBLIC_SITE_URL=

# --- Authentication (backend-side; session is an httpOnly cookie) ---
AUTH_SECRET=
AUTH_PROVIDER_URL=

# --- Admin area login (server-only; gates /admin via proxy.ts) ---
# This is an interim, single-shared-password gate for the demo admin
# panel — not real per-admin authentication. See BACKEND_INTEGRATION.md
# for what "real" admin auth needs to look like before launch. Set these
# in your hosting platform's environment variables — never commit real
# values here or anywhere else in the repo.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Random string used to sign the admin session cookie. Any long random
# value works — generate one with, e.g., `openssl rand -base64 32`.
ADMIN_SESSION_SECRET=

# --- Primary application database ---
DATABASE_URL=

# --- KYC / identity verification provider ---
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_API_URL=

# --- Payments / deposits ---
PAYMENTS_PROVIDER_API_KEY=
PAYMENTS_PROVIDER_WEBHOOK_SECRET=

# --- Withdrawals processing system ---
WITHDRAWALS_API_KEY=
WITHDRAWALS_API_URL=

# --- Live market data provider ---
MARKET_DATA_API_KEY=
MARKET_DATA_WS_URL=

# --- Trading execution API ---
TRADING_API_KEY=
TRADING_API_URL=

# --- Bitcoin wallet infrastructure (VPS-hosted, backend-only) ---
# The frontend never sees or handles private keys — only deposit
# addresses, balances, and transaction status returned by the backend.
BITCOIN_NODE_RPC_URL=
BITCOIN_WALLET_SERVICE_API_KEY=

# --- Customer support platform ---
SUPPORT_PLATFORM_API_KEY=
